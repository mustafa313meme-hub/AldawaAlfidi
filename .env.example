APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
CORS_ORIGINS=http://localhost:3001

POSTGRES_USER=silverpharma
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=silverpharma
DATABASE_URL=postgresql://silverpharma:change_me_db_password@localhost:5432/silverpharma?schema=public

# Generate with: openssl rand -base64 48   (min 32 chars, must differ)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

REDIS_URL=redis://localhost:6379

STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# First Super Admin (used only by the seed script). No default password on purpose.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=مدير النظام

# Notifications: run the daily checks in the background (expiry, low stock, overdue customers)
NOTIFICATIONS_JOB=false
# none | log   (real push via Firebase is not implemented; see docs/PHASE_9_STATUS.md)
PUSH_PROVIDER=none

# ── Production only (docker-compose.prod.yml) ──
DOMAIN=erp.example.com
# the restricted runtime role created by deploy/db-roles.sql
APP_DB_USER=silverpharma_app
APP_DB_PASSWORD=
